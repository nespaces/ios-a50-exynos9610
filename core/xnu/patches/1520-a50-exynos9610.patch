+/*
+ * HakiOS (Galaxy A50, boot-arg lpm9610=1): the CPU part of Samsung's pmucal_lpm_init for the Exynos 9610, which its
+ * kernel runs (cal_if_init) before smp_init and S-Boot does not: the clusters' L2, CPU and non-CPU power options of the
+ * PMU (0x11860000). Samsung's 4.14 kernel for the A50, drivers/soc/samsung/cal-if/exynos9610/pmucal_system_exynos9610.h,
+ * in its order; only these entries (none of TOP, MEMORY or PS_HOLD). The S9's big cores needed the same kind of thing
+ * (devices/starlte/README.md, "The cores"). Once, before the first CPU_ON; every value said before and after.
+ */
+static void
+psci_smp_lpm9610(void)
+{
+	static bool done;
+	static const struct { uint32_t at, mask, value; const char *name; } seq[] = {
+		{ 0x2608, 1u << 17, 0, "CLUSTER0_L2_OPTION" }, { 0x2628, 1u << 17, 0, "CLUSTER1_L2_OPTION" },
+		{ 0x2608, 1u << 16, 1u << 16, "CLUSTER0_L2_OPTION" }, { 0x2628, 1u << 16, 1u << 16, "CLUSTER1_L2_OPTION" },
+		{ 0x2008, 1u << 12, 0, "CLUSTER0_CPU0_OPTION" }, { 0x2088, 1u << 12, 0, "CLUSTER0_CPU1_OPTION" },
+		{ 0x2108, 1u << 12, 0, "CLUSTER0_CPU2_OPTION" }, { 0x2188, 1u << 12, 0, "CLUSTER0_CPU3_OPTION" },
+		{ 0x2208, 1u << 12, 0, "CLUSTER1_CPU0_OPTION" }, { 0x2288, 1u << 12, 0, "CLUSTER1_CPU1_OPTION" },
+		{ 0x2308, 1u << 12, 0, "CLUSTER1_CPU2_OPTION" }, { 0x2388, 1u << 12, 0, "CLUSTER1_CPU3_OPTION" },
+		{ 0x2008, 0x3f, 0x1f, "CLUSTER0_CPU0_OPTION" }, { 0x2088, 0x3f, 0x1f, "CLUSTER0_CPU1_OPTION" },
+		{ 0x2108, 0x3f, 0x1f, "CLUSTER0_CPU2_OPTION" }, { 0x2188, 0x3f, 0x1f, "CLUSTER0_CPU3_OPTION" },
+		{ 0x2208, 0x3f, 0x1f, "CLUSTER1_CPU0_OPTION" }, { 0x2288, 0x3f, 0x1f, "CLUSTER1_CPU1_OPTION" },
+		{ 0x2308, 0x3f, 0x1f, "CLUSTER1_CPU2_OPTION" }, { 0x2388, 0x3f, 0x1f, "CLUSTER1_CPU3_OPTION" },
+		{ 0x2408, 0x3fu << 8, 0x1fu << 8, "CLUSTER0_NONCPU_OPTION" }, { 0x2428, 0x3fu << 8, 0x1fu << 8, "CLUSTER1_NONCPU_OPTION" },
+		{ 0x2008, 1u << 28, 1u << 28, "CLUSTER0_CPU0_OPTION" }, { 0x2088, 1u << 28, 1u << 28, "CLUSTER0_CPU1_OPTION" },
+		{ 0x2108, 1u << 28, 1u << 28, "CLUSTER0_CPU2_OPTION" }, { 0x2188, 1u << 28, 1u << 28, "CLUSTER0_CPU3_OPTION" },
+		{ 0x2208, 1u << 28, 1u << 28, "CLUSTER1_CPU0_OPTION" }, { 0x2288, 1u << 28, 1u << 28, "CLUSTER1_CPU1_OPTION" },
+		{ 0x2308, 1u << 28, 1u << 28, "CLUSTER1_CPU2_OPTION" }, { 0x2388, 1u << 28, 1u << 28, "CLUSTER1_CPU3_OPTION" },
+	};
+	uint32_t on = 0;
+	volatile uint8_t *pmu;
+
+	if (done || !PE_parse_boot_argn("lpm9610", &on, sizeof(on)) || on == 0) {
+		return;
+	}
+	done = true;
+	pmu = (volatile uint8_t *)ml_io_map(0x11860000, 0x3000);
+	if (pmu == NULL) {
+		psci_smp_step("psci: lpm9610: the PMU could not be mapped\n");
+		return;
+	}
+	{
+		/* CPUCL0's clock, read only (the port's analysis notes: PLL_CPUCL0 CON0 0x10900140, its mux 0x10901000 bit 0 = 0 the
+		 * PLL, the switch-user mux 0x10900120 bit 4; M [25:16], P [13:8], S [2:0] on 26 MHz) */
+		volatile uint8_t *cmu = (volatile uint8_t *)ml_io_map(0x10900000, 0x2000);
+
+		if (cmu != NULL) {
+			uint32_t con0 = *(volatile uint32_t *)(cmu + 0x140), m = (con0 >> 16) & 0x3ff, p = (con0 >> 8) & 0x3f, sdiv = con0 & 7;
+			uint64_t khz = p != 0 ? 26000ULL * m / ((uint64_t)p << sdiv) : 0;
+
+			psci_smp_step("psci: lpm9610: PLL_CPUCL0 CON0 %#x (M %u P %u S %u: %llu kHz, %s, %s, bit4 %u), MUX_CPUCL0 %#x, "
+			    "SWITCH_USER %#x, DIV_CPU %#x\n", con0, m, p, sdiv, khz, (con0 >> 31) & 1 ? "enabled" : "NOT enabled",
+			    (con0 >> 29) & 1 ? "stable" : "not stable", (con0 >> 4) & 1, *(volatile uint32_t *)(cmu + 0x1000),
+			    *(volatile uint32_t *)(cmu + 0x120), *(volatile uint32_t *)(cmu + 0x1810));
+		}
+	}
+	if (on >= 3) {
+		/* PS_HOLD_CONTROL (+0x330C) bits 31 and 8, first, as pmucal_lpm_init sets them (the port's analysis notes) */
+		volatile uint32_t *ps = (volatile uint32_t *)(pmu + 0x330C);
+		uint32_t was;
+
+		pmu = (volatile uint8_t *)ml_io_map(0x11860000, 0x4000);
+		ps = (volatile uint32_t *)(pmu + 0x330C);
+		was = *ps;
+		*ps = was | (1u << 31) | (1u << 8);
+		__builtin_arm_dsb(DSB_SY);
+		psci_smp_step("psci: lpm9610: PS_HOLD_CONTROL +0x330c: %#x -> %#x\n", was, *ps);
+	}
+	psci_smp_step("psci: lpm9610: CPU2 CONFIGURATION %#x STATUS %#x, CPU3 %#x %#x, CLUSTER1 CPU0 %#x %#x before\n",
+	    *(volatile uint32_t *)(pmu + 0x2100), *(volatile uint32_t *)(pmu + 0x2104), *(volatile uint32_t *)(pmu + 0x2180),
+	    *(volatile uint32_t *)(pmu + 0x2184), *(volatile uint32_t *)(pmu + 0x2200), *(volatile uint32_t *)(pmu + 0x2204));
+	for (unsigned i = 0; i < sizeof(seq) / sizeof(seq[0]); i++) {
+		volatile uint32_t *r = (volatile uint32_t *)(pmu + seq[i].at);
+		uint32_t was = *r;
+
+		if (on >= 2) {
+			*r = (was & ~seq[i].mask) | seq[i].value;
+			__builtin_arm_dsb(DSB_SY);
+		}
+		psci_smp_step("psci: lpm9610: %s +%#x: %#x -> %#x%s\n", seq[i].name, seq[i].at, was, *r,
+		    on >= 2 ? "" : " (lpm9610=1: read only)");
+	}
+}
+
+/*
+ * HakiOS (Galaxy A50, boot-arg psci_low=PA): CPU_ON is given PA, below 4 GB, instead of the kernel's reset vector
+ * (in the bank from 0x880000000), and there a trampoline -- "TRAMP" into the console zone of TWRP's ramoops
+ * (0xF9D90000, as start.s's own note), then a branch to the reset vector. Whether Samsung's EL3 on the 9610 keeps
+ * only 32 bits of the entry (the port's analysis notes, step D). The page is outside XNU's RAM; written through a device
+ * mapping, so in memory for a core whose MMU and caches are off.
+ */
+__asm__(
+	"	.text\n"
+	"	.balign 8\n"
+	"	.globl _hk_tramp\n"
+	"_hk_tramp:\n"
+	"	movz	x9, #0xF9D9, lsl #16\n"
+	"	movz	w10, #0x5254\n"
+	"	movk	w10, #0x4d41, lsl #16\n"
+	"	str	w10, [x9, #12]\n"
+	"	movz	w10, #0x0a50\n"
+	"	strh	w10, [x9, #16]\n"
+	"	mov	w10, #6\n"
+	"	str	w10, [x9, #4]\n"
+	"	str	w10, [x9, #8]\n"
+	"	movz	w10, #0x4244\n"
+	"	movk	w10, #0x4347, lsl #16\n"
+	"	str	w10, [x9]\n"
+	"	dsb	sy\n"
+	"	ldr	x16, 1f\n"
+	"	br	x16\n"
+	"	.balign 8\n"
+	"1:	.quad 0\n"
+	"	.globl _hk_tramp_end\n"
+	"_hk_tramp_end:\n");
+extern const char hk_tramp[], hk_tramp_end[];
+
+static uint64_t
+psci_smp_low_entry(uint64_t entry)
+{
+	uint64_t low = 0;
+	volatile uint8_t *page;
+	size_t n = (size_t)(hk_tramp_end - hk_tramp);
+
+	if (!PE_parse_boot_argn("psci_low", &low, sizeof(low)) || low == 0 || (low & 0xfff) || low >= (1ULL << 32)) {
+		return entry;
+	}
+	page = (volatile uint8_t *)ml_io_map((vm_offset_t)low, PAGE_SIZE);
+	if (page == NULL) {
+		psci_smp_step("psci: psci_low=%#llx could not be mapped: the entry stays %#llx\n", low, entry);
+		return entry;
+	}
+	for (size_t i = 0; i < n - 8; i++) {
+		page[i] = (uint8_t)hk_tramp[i];
+	}
+	*(volatile uint64_t *)(page + n - 8) = entry;
+	__builtin_arm_dsb(DSB_SY);
+	psci_smp_step("psci: psci_low: a %zu-byte trampoline at %#llx to %#llx; CPU_ON is given %#llx\n", n, low, entry, low);
+	return low;
+}
+
 kern_return_t
