# HakiOS fragment: the Samsung Galaxy A50 (devices/a50, SM-A505FN) -- what is true of this phone and of no other.
# The first bring-up: the common kernel on two A53s and nothing of the phone's yet. The drivers left built in are the
# S9's for the same SoC blocks (USI/HSI2C, ACPM, UFS, the USB gadget); each is off until its own boot-argument, as on
# the S9. What is another chip on this phone (the S2MPU09 PMIC where the S9 has the S2MPS18, the Melfas touch where it
# has Samsung's, Mali-G72 MP3 where it has the MP18) is left out with the reason.
CONFIG_DEVICE="a50"
# CONFIG_FIRMWARE is "device" in the common kernel; the RAM profile (configs/a50-ram.config) says "none".
# The I2C of the USI blocks (drivers/core/hakios.exynos_hsi2c.c): the touch screen's bus; not started by default
CONFIG_HAKIOS_EXYNOS_HSI2C=y
# An SPI master of a USI block, polled (drivers/core/hakios.exynos_spi.c); nothing on this phone uses it yet
CONFIG_HAKIOS_EXYNOS_SPI=y
# The power processor asked through its ACPM firmware (drivers/core/hakios.exynos_acpm.c): the PMIC's registers and
# the clocks' DVFS sets. The 9610 has ACPM too; whether the S9's register map fits is to be seen (acpm= off by default)
CONFIG_HAKIOS_EXYNOS_ACPM=y
# The storage through the loader's own UFS driver (ufs=2...), the same controller family as the S9's; off by default
CONFIG_HAKIOS_UFS=y
# The GPU, a Mali-G72 MP3 (drivers/gpu/hakios.mali.c is the S9's MP18's; the steps that fit are to be seen): off
CONFIG_HAKIOS_MALI=y
# The USB port as a link to a host: the kernel's log over a CDC-ACM serial port (drivers/core/hakios.dwc3.c and
# hakios.exynos_usb.c, the 9810's PHY and clocks; the 9610's PHY to be checked). Off until usb_gadget=N.
CONFIG_HAKIOS_USB_GADGET=y
CONFIG_HAKIOS_EXYNOS_USB=y
# Another chip here, the S9's driver left out:
# CONFIG_HAKIOS_S6SY761 is not set
# The touch screen: a Melfas MSS100 on i2c_4 (drivers/input/hakios.melfas_mss100.c); off until boot-arg melfas=1
CONFIG_HAKIOS_MELFAS_MSS100=y
# CONFIG_HAKIOS_MAX77705 is not set
# CONFIG_HAKIOS_S2MPS18_RTC is not set
# CONFIG_HAKIOS_EXYNOS_TMU is not set
# CONFIG_HAKIOS_EXYNOS_M3 is not set
# CONFIG_HAKIOS_EXYNOS_CPUFREQ is not set
# CONFIG_HAKIOS_EXYNOS_CAMERA is not set
# CONFIG_HAKIOS_S2MPB02_TORCH is not set
# CONFIG_HAKIOS_MAX98512 is not set
# The speakers' guard (drivers/audio/hakios.guard.c): no DSP protects the A50's speaker here
CONFIG_HAKIOS_GUARD=y
# ABOX, the 9610's audio block, its CPU off (abox=8 abox_soc=9610), and the speaker's TFA9872 (tfa9872=3)
CONFIG_HAKIOS_EXYNOS_ABOX=y
CONFIG_HAKIOS_TFA9872=y
CONFIG_HAKIOS_RT5665=y
CONFIG_HAKIOS_CAMPWR=y
CONFIG_HAKIOS_A50_TMU=y
# CONFIG_HAKIOS_EXYNOS_PCIE is not set
# CONFIG_HAKIOS_BRCMFMAC is not set
# Station and Apple80211 (Settings' Wi-Fi) over the S620. Not Qualcomm's CONFIG_HAKIOS_WIFI.
CONFIG_HAKIOS_WIFI_STA=y
CONFIG_HAKIOS_BCM4361_BT=y
# Nothing else of any phone's:
# CONFIG_HAKIOS_ADSP is not set
# CONFIG_HAKIOS_SPEAKER is not set
# CONFIG_HAKIOS_SOUND is not set
# CONFIG_HAKIOS_MIC is not set
# CONFIG_HAKIOS_BT is not set
# CONFIG_HAKIOS_CAMERA is not set
# CONFIG_HAKIOS_TORCH is not set
# CONFIG_HAKIOS_SOCINFO is not set
# CONFIG_HAKIOS_ADRENO is not set
# CONFIG_HAKIOS_HAPTIC is not set
# CONFIG_HAKIOS_GOODIX is not set
# CONFIG_HAKIOS_BUTTONS is not set
# CONFIG_HAKIOS_QMI is not set
# CONFIG_HAKIOS_MODEM is not set
# The battery: the SM5713's fuel gauge and MUIC, read only (drivers/power/hakios.sm5713.c, sm5713=1), for HakiosBattery
CONFIG_HAKIOS_BATTERY=y
CONFIG_HAKIOS_SM5713=y
# CONFIG_HAKIOS_CPUFREQ is not set
# CONFIG_HAKIOS_THERMAL is not set
# CONFIG_HAKIOS_PMIC is not set
# CONFIG_HAKIOS_BATTGUARD is not set
# CONFIG_HAKIOS_WIFI is not set
# The keys: power and volume on gpa1 of the ALIVE block (drivers/input/hakios.exynos_keys.c, exynos_keys=2)
CONFIG_HAKIOS_EXYNOS_KEYS=y
# CONFIG_TOUCHSCREEN is not set
# CONFIG_GPU is not set
# CONFIG_ADSP is not set
# CONFIG_SOUND is not set
# CONFIG_WIFI is not set
# CONFIG_MODEM is not set
# CONFIG_MODEM_AGAIN is not set
# added by a50 bring-up: virtio-net needs WIFI_STA which is off here
# CONFIG_HAKIOS_VIRTIO_NET is not set
# CONFIG_HAKIOS_VIRTIO_INPUT is not set
# CONFIG_HAKIOS_VIRTIO_SOUND is not set
# CONFIG_HAKIOS_VIRTIO_BLK is not set
CONFIG_HAKIOS_GPIO_VIB=y
CONFIG_HAKIOS_EA8076=y
# The Wi-Fi/Bluetooth chip, SCSC S620 (drivers/wifi/hakios.scsc.c, scsc=N)
CONFIG_HAKIOS_SCSC=y
