# SM-A505FN / Exynos 9610: first kernel and raw-syscall PID 1, the image flashed to BOOT.
# Apply over a50_defconfig. The boot shim starts the loader (no UEFI); the panel shows the S-Boot framebuffer.
# isa_floor=1 goes on the command line (every core is ARMv8.0, xnu/patches/1510).
CONFIG_FIRMWARE="none"
CONFIG_CPUS=2
CONFIG_BOOTCPU=2
# CONFIG_UFS is not set
# CONFIG_UFS_WRITE is not set
# CONFIG_VAR_STORE is not set
# CONFIG_VAR_HFS is not set
CONFIG_MALI=0
# CONFIG_GPU is not set
# CONFIG_WIFI is not set
# CONFIG_BRCMFMAC is not set
# CONFIG_BT is not set
# CONFIG_S6SY761 is not set
# CONFIG_EXYNOS_KEYS is not set
# CONFIG_PANEL is not set
# CONFIG_ABOX is not set
# CONFIG_TORCH is not set
# CONFIG_MODEM is not set
# CONFIG_USB_GADGET is not set
# CONFIG_CPUFREQ_GOV is not set
# CONFIG_MALI_GOV is not set
